{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InkPads",
  "version": "0.1.1",
  "identifier": "dev.pages.inkpads.desktop",
  "build": {
    "frontendDist": "https://inkpads.pages.dev/",
    "devUrl": "https://inkpads.pages.dev/"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "InkPads",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "maximized": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0OTQ4QjdFOEJFQ0FFQUYKUldTdnJ1eUxmb3VVeERwb1Uva0s2cG1wMTlWL25GTVc2MXRRbGJSamNSZisyeUE4TzNIRnU5bFQK",
      "endpoints": [
        "https://github.com/the-mongols/InkPads-Desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
